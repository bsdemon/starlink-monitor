# Database
POSTGRES_DB=starlink
POSTGRES_USER=starlink
POSTGRES_PASSWORD=starlinkpass
DB_HOST=timescaledb
DB_PORT=5432

DATABASE_URL=postgresql://starlink:starlinkpass@timescaledb:5432/starlink

# API
API_HOST=0.0.0.0
API_PORT=8000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Starlink OAuth / API access
STARLINK_CLIENT_ID=change-me
STARLINK_CLIENT_SECRET=change-me

STARLINK_TOKEN_URL=https://starlink.com/api/auth/connect/token
STARLINK_TELEMETRY_URL=https://starlink.com/api/public/v2/telemetry/stream

GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Django settings
DJANGO_SECRET_KEY=your-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*